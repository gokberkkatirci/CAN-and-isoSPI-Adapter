(version 1)
# Generated by tools/generate_t41.py. Board-level insulation still needs a system review.
# Each floating isoSPI cable domain keeps 8 mm copper clearance to all other copper.
(rule "isoSPI port 1 8 mm"
  (constraint clearance (min 8mm))
  (condition "A.NetName == '/ISO1C_*' && B.NetName != '/ISO1C_*' && B.NetName != 'unconnected-*'"))
(rule "isoSPI port 2 8 mm"
  (constraint clearance (min 8mm))
  (condition "A.NetName == '/ISO2C_*' && B.NetName != '/ISO2C_*' && B.NetName != 'unconnected-*'"))
(rule "isoSPI port 3 8 mm"
  (constraint clearance (min 8mm))
  (condition "A.NetName == '/ISO3C_*' && B.NetName != '/ISO3C_*' && B.NetName != 'unconnected-*'"))
(rule "isoSPI port 4 8 mm"
  (constraint clearance (min 8mm))
  (condition "A.NetName == '/ISO4C_*' && B.NetName != '/ISO4C_*' && B.NetName != 'unconnected-*'"))
(rule "isoSPI port 5 8 mm"
  (constraint clearance (min 8mm))
  (condition "A.NetName == '/ISO5C_*' && B.NetName != '/ISO5C_*' && B.NetName != 'unconnected-*'"))
(rule "isoSPI port 6 8 mm"
  (constraint clearance (min 8mm))
  (condition "A.NetName == '/ISO6C_*' && B.NetName != '/ISO6C_*' && B.NetName != 'unconnected-*'"))
# Each isolated CAN domain keeps 3 mm from logic copper and from the other CAN domains.
(rule "CAN1 isolation 3 mm"
  (constraint clearance (min 3mm))
  (condition "A.NetName == '/CAN1I_*' && B.NetName != '/CAN1I_*' && B.NetName != 'unconnected-*' && B.NetName != ''"))
(rule "CAN2 isolation 3 mm"
  (constraint clearance (min 3mm))
  (condition "A.NetName == '/CAN2I_*' && B.NetName != '/CAN2I_*' && B.NetName != 'unconnected-*' && B.NetName != ''"))
(rule "CAN3 isolation 3 mm"
  (constraint clearance (min 3mm))
  (condition "A.NetName == '/CAN3I_*' && B.NetName != '/CAN3I_*' && B.NetName != 'unconnected-*' && B.NetName != ''"))
(rule "CAN4 isolation 3 mm"
  (constraint clearance (min 3mm))
  (condition "A.NetName == '/CAN4I_*' && B.NetName != '/CAN4I_*' && B.NetName != 'unconnected-*' && B.NetName != ''"))
(rule "CAN5 isolation 3 mm"
  (constraint clearance (min 3mm))
  (condition "A.NetName == '/CAN5I_*' && B.NetName != '/CAN5I_*' && B.NetName != 'unconnected-*' && B.NetName != ''"))
(rule "CAN6 isolation 3 mm"
  (constraint clearance (min 3mm))
  (condition "A.NetName == '/CAN6I_*' && B.NetName != '/CAN6I_*' && B.NetName != 'unconnected-*' && B.NetName != ''"))
